            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/agent-hook.sh\" codex Interrupt",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
